# Server
PORT=3000

# SQLite database (Prisma)
DATABASE_URL="file:./ticketing.db"

# API auth token — clients must send: Authorization: Bearer <this value>
API_TOKEN=changeme-local-dev-token

# Outbound webhook (point this at your Copilot Studio trigger URL)
WEBHOOK_TARGET_URL=https://example.com/copilot-studio-trigger
WEBHOOK_AUTH_TOKEN=changeme-webhook-token
