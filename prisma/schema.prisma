generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ticket {
  id                  Int      @id @default(autoincrement())
  subject             String
  description         String
  channel             String // email | chat | phone | web_form
  requesterName       String   @map("requester_name")
  requesterEmail      String   @map("requester_email")
  status              String   @default("new") // new | open | pending | solved | closed
  type                String? // question | incident | problem | task
  priority            String   @default("normal") // low | normal | high | urgent
  groupName           String?  @map("group_name")
  assignee            String?
  tags                String? // comma-separated string
  classificationResult String? @map("classification_result")
  confidenceScore     Float?   @map("confidence_score")
  complianceStatus    String   @default("none") @map("compliance_status") // none | pending_review | cleared | actioned
  flagType            String   @default("[]") @map("flag_type") // JSON array string, e.g. ["aml","fraud"]
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  notes InternalNote[]

  @@map("tickets")
}

model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int      @map("ticket_id")
  text      String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("internal_notes")
}
